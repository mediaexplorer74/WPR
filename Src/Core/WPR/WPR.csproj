<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFramework Condition="'$(WPRTargetPlatform)' != 'Android'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(WPRTargetPlatform)' == 'Android'">net8.0-android</TargetFramework>
    <EFVersion>6.0.8</EFVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFMpegCore" Version="4.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFVersion)" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.Reactive" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(TargetFramework)' == 'net8.0-android'" Include="$(SolutionDir)\JavaBindings\com.arthenica.ffmpegkit\com.arthenica.ffmpegkit.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\Microsoft.Device.Sensors\Microsoft.Devices.Sensors.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\Microsoft.Phone\Microsoft.Phone.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\Microsoft.Xna.Framework.GamerServices\Microsoft.Xna.Framework.GamerServices.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\System.Device\System.Device.csproj" />
    <ProjectReference Include="$(SolutionDir)\ThirdParty\fna\FNA.Core.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Game\Microsoft.Xna.Framework.Game.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework\Microsoft.Xna.Framework.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Graphics\Microsoft.Xna.Framework.Graphics.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Input.Touch\Microsoft.Xna.Framework.Input.Touch.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Audio\Microsoft.Xna.Framework.Audio.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Content\Microsoft.Xna.Framework.Content.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Media\Microsoft.Xna.Framework.Media.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\XnaFacades\Microsoft.Xna.Framework.Input\Microsoft.Xna.Framework.Input.csproj" />
