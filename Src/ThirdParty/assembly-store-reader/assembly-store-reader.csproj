<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFrameworks>net9.0-android35</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <TargetFrameworks>net8.0-windows10.0.26100.0</TargetFrameworks>
  </PropertyGroup>
  
  <PropertyGroup>
    <Version>0.0.1</Version>
    <OutputType>Library</OutputType>
    <!--TargetFrameworks>net8.0-windows10.0.26100.0;net9.0-android35</TargetFrameworks-->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Xamarin.Android.AssemblyStoreReader</RootNamespace>
   	<SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android35'">21</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.2.16" />
  </ItemGroup>
</Project>
