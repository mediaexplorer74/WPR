        <StackPanel Grid.Row="1">
            <Button x:Name="ProcessButton" Content="Process" Click="ProcessButton_Click" 
                    Height="44" Margin="10,-10,10,0"/>
            <TextBlock x:Name="ResultText" Text="[]" Height="64"/>

        </StackPanel>

        <!-- AppBar with Primary Commands -->
        <CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarToggleButton Icon="Setting" Label="Settings" Click="SettingsButton_Click"/>
                <AppBarToggleButton Icon="Calendar" Label="About" Click="AboutButton_Click"/>
                <AppBarToggleButton Icon="ReShare" Label="Share" Click="ShareButton_Click"/>
            </CommandBar.PrimaryCommands>

